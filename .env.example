# Copy to .env.local for local dev, or set these in your hosting dashboard.

# --- Public site: the pre-launch vault wall ---
# VAULT_SECRET must be a long random string (64+ hex chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_USER=replace-with-an-invite-username
VAULT_PASS=replace-with-a-long-random-password
VAULT_SECRET=replace-me-with-a-long-random-string

# Fail-closed launch gate for the vault, metadata, robots.txt and sitemap.
# Keep false until the site should be public and indexable.
SITE_LAUNCHED=false

# --- CMS: hq.milosnovakovic.com admin panel ---
# HQ_SECRET signs the admin session cookie (independent of the vault):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HQ_PASS_HASH is a scrypt hash of your password:
#   node scripts/hash-password.mjs "your-strong-password"
HQ_USER=milos
HQ_SECRET=replace-me-with-a-long-random-string
HQ_PASS_HASH=replace-with-output-of-hash-password-script

# Public site origin (used for metadataBase / OG URLs).
NEXT_PUBLIC_SITE_URL=https://milosnovakovic.com

# Optional: exact CMS host. Defaults to any "hq.*" host if unset.
# ADMIN_HOST=hq.milosnovakovic.com

# --- Local dev only ---
# Force the CMS storage backend ("blobs" | "fs"). Auto-detected otherwise:
# Netlify Blobs when the Netlify context is present, filesystem for `next dev`.
# CMS_STORE_BACKEND=fs
